rules_version = '2';

// Security rules for the rinlada-plant-stock Firestore database.
//
// Model:
// - The public showcase (showcase/index.html/showcase.js) never authenticates —
//   it only needs READ access to the collections that back the public
//   catalog. Those reads are allowed for anyone, with no login required.
// - The admin app (index.html/app.js) requires a real Firebase Auth sign-in
//   (see the login screen wired up in app.js / firebase-client.js's
//   fbAdminLogin()). ALL writes to every collection below require
//   request.auth != null — an unauthenticated visitor, or the admin page
//   before someone logs in, cannot create, edit, delete, or restore
//   anything.
// - Everything not explicitly listed is denied for both read and write by
//   the catch-all rule at the bottom. Adding a new collection later means
//   adding a matching block here first, or it will be unreachable by design.
//
// Deploy with the Firebase CLI from the repo root:
//   firebase deploy --only firestore:rules
// See docs/firestore-ops.md for the full one-time setup (installing the
// CLI, logging in, linking this project) if you haven't deployed rules
// from this machine before.
service cloud.firestore {
  match /databases/{database}/documents {

    // Catalog collections shown on the public showcase. Publicly readable;
    // writes only from a signed-in admin.
    match /styleOverrides/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /plantOverrides/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /plantShowcaseIndex/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /customPlants/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gardenPortfolio/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gardenSupplies/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tiny "did anything change" marker the showcase polls instead of
    // re-downloading the whole catalog (see bumpCatalogRevision() in app.js
    // and checkForCatalogUpdates() in showcase.js). Contains only a number
    // and a timestamp — nothing sensitive — so public read is fine.
    match /catalogMeta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Used to sync price/size to a separate LINE bot integration. Never
    // read by the showcase or by unauthenticated clients.
    match /plants/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
